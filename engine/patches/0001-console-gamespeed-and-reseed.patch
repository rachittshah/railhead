+/**
+ * Railhead: set the game speed from the console / admin RCON so a dedicated server can
+ * fast-forward. 100 = normal speed, 0 = unlimited. Reset to 100 by every new game or load.
+ */
+static bool ConGameSpeed(std::span<std::string_view> argv)
+{
+	if (argv.empty()) {
+		IConsolePrint(CC_HELP, "Set the game speed in percent of normal speed, 0 = unlimited. Usage: 'gamespeed [<percent>]'.");
+		return true;
+	}
+
+	if (argv.size() == 1) {
+		IConsolePrint(CC_DEFAULT, "Game speed: {}", _game_speed);
+		return true;
+	}
+
+	auto speed = ParseType<uint16_t>(argv[1]);
+	if (!speed.has_value()) {
+		IConsolePrint(CC_ERROR, "'{}' is not a valid speed.", argv[1]);
+		return true;
+	}
+	_game_speed = *speed;
+	IConsolePrint(CC_DEFAULT, "Game speed: {}", _game_speed);
+	return true;
+}
+
+/**
+ * Railhead: reseed the game-state random generator. Used only on throw-away fork servers so a
+ * fork samples a plausible future instead of replaying the true one (no clients => no desync).
+ */
+static bool ConReseed(std::span<std::string_view> argv)
+{
+	if (argv.empty()) {
+		IConsolePrint(CC_HELP, "Reseed the game-state random generator (fork servers only). Usage: 'reseed <seed>'.");
+		return true;
+	}
+
+	if (argv.size() != 2) return false;
+	auto seed = ParseType<uint32_t>(argv[1]);
+	if (!seed.has_value()) {
+		IConsolePrint(CC_ERROR, "'{}' is not a valid seed.", argv[1]);
+		return true;
+	}
+	_random.SetSeed(*seed);
+	IConsolePrint(CC_DEFAULT, "Reseeded: {}", *seed);
+	return true;
+}
